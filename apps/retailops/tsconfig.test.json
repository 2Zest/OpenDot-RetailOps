{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./.typecheck",
    "declaration": false,
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "test/unit/**/*.test.ts", "test/contract/**/*.test.ts", "vitest.config.ts"],
  "exclude": ["dist", "node_modules", ".typecheck"]
}
